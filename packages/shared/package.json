{
  "name": "@secretforge/shared",
  "version": "1.0.0",
  "description": "Shared types, validation schemas and the secret detection engine used by SecretForge AI packages",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scanner": {
      "types": "./dist/security/secretDetector.d.ts",
      "import": "./dist/security/secretDetector.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "keywords": [
    "secrets",
    "secret-detection",
    "security",
    "schemas",
    "zod",
    "shared"
  ],
  "author": "LoveLogicAILLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LoveLogicAILLC/secretforge-ai.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/LoveLogicAILLC/secretforge-ai/issues"
  },
  "homepage": "https://github.com/LoveLogicAILLC/secretforge-ai/tree/main/packages/shared#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
