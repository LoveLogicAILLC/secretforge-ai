{
  "name": "secretforge-api",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "SECRETS_VAULT",
      "id": "b71460ab4b6447b2924b56080365d3c4"
    },
    {
      "binding": "RATE_LIMIT_KV",
      "id": "f044969427384382b43af253ec64e41c"
    }
  ],
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "secretforge-db",
      "database_id": "83cce8ad-9f2e-404f-9ada-943849e14efe"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTOR_DB",
      "index_name": "api-docs-index"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SECRET_AGENT",
        "class_name": "SecretAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SecretAgent"]
    }
  ],
  "vars": {
    "OPENAI_API_KEY": "",
    "ANTHROPIC_API_KEY": "",
    "ENCRYPTION_KEY": ""
  }
}
